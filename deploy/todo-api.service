# API 서버를 systemd 서비스로 실행하는 설정
# 설치 위치: /etc/systemd/system/todo-api.service
[Unit]
Description=Todo API (Express)
# 네트워크와 PostgreSQL 이 켜진 다음에 시작
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=lab
# 이 폴더의 .env 를 dotenv 가 읽습니다.
WorkingDirectory=/home/lab/deploy/todo-app/api
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/index.js
# 프로세스가 죽으면 3초 뒤 다시 시작
Restart=always
RestartSec=3

[Install]
# 부팅 시 자동 시작
WantedBy=multi-user.target
